rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: users can read and write their own profile; admins can read all
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Enquiries collection: anyone (sandbox members & public) can create an enquiry; admins can read & update
    match /enquiries/{enquiryId} {
      allow create: if true;
      allow read, update, delete: if true;
    }

    // CMS products, transactions, and library
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
