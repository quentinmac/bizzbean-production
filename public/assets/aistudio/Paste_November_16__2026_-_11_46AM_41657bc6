    <script>
      function getVal(id) { return parseFloat(document.getElementById(id).value) || 0; }
      function setVal(id, val) { 
        const el = document.getElementById(id);
        if (el.classList.contains('calculation')) {
          el.value = val.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
        } else {
          el.value = val;
        }
      }

      function calculate() {
        
      const months = getVal('months');
      const revenue = getVal('revenue');
      const cos = getVal('cos');
      const gp = revenue + cos;
      setVal('gp', gp);

      const gpAdj = getVal('gpAdj');
      const otherInc = getVal('otherInc');
      const totalInc = gp + gpAdj + otherInc;
      setVal('totalInc', totalInc);

      const opExp = getVal('opExp');
      const nop = totalInc + opExp;
      setVal('nop', nop);

      // Ratios
      setVal('gpPct', revenue !== 0 ? gp / revenue : 0);
      setVal('gpAdjPct', revenue !== 0 ? gpAdj / revenue : 0);
      setVal('otherIncPct', revenue !== 0 ? otherInc / revenue : 0);
      setVal('totalIncPct', revenue !== 0 ? totalInc / revenue : 0);
      setVal('opExpPct', revenue !== 0 ? opExp / revenue : 0);
      setVal('nopPct', revenue !== 0 ? nop / revenue : 0);

      // Balance Sheet
      const fixedAssets = getVal('fixedAssets');
      const inventory = getVal('inventory');
      const receivables = getVal('receivables');
      const totalAssets = fixedAssets + inventory + receivables;
      setVal('totalAssets', totalAssets);

      const payables = getVal('payables');
      const noa = totalAssets + payables;
      setVal('noa', noa);

      // Efficiency Ratios
      const ros = revenue !== 0 ? nop / revenue : 0;
      setVal('ros', ros);
      const at = noa !== 0 ? revenue / noa : 0;
      setVal('at', at);
      const roa = ros * at;
      setVal('roa', roa);

      // Target Efficiency Ratios
      const targetRos = getVal('targetRos') / 100;
      const targetRoa = getVal('targetRoa') / 100;
      const targetAt = targetRos !== 0 ? targetRoa / targetRos : 0;
      setVal('targetAt', targetAt);

      // Trading account - % adjustments
      const adjRevPct = getVal('adjRevPct') / 100;
      const adjGpPct = getVal('adjGpPct') / 100;
      const adjGpAdjPct = getVal('adjGpAdjPct') / 100;
      const adjOtherIncPct = getVal('adjOtherIncPct') / 100;
      const adjOpExpPct = getVal('adjOpExpPct') / 100;

      // Adjusted trading account
      const adjRev = revenue * (1 + adjRevPct);
      setVal('adjRev', adjRev);

      // Changes required to achieve target ROS
      setVal('actualNop', nop);
      const requiredNop = adjRev * targetRos;
      setVal('requiredNop', requiredNop);
      setVal('nopAdj', requiredNop - nop);

      // Changes required to achieve target ROA
      setVal('actualNoa', noa);
      const requiredNoa = targetAt !== 0 ? adjRev / targetAt : 0;
      setVal('requiredNoa', requiredNoa);
      setVal('noaAdj', requiredNoa - noa);

      const currentGpMargin = revenue !== 0 ? gp / revenue : 0;
      const adjGpMargin = currentGpMargin + adjGpPct;
      const adjGp = adjRev * adjGpMargin;
      setVal('adjGp', adjGp);
      setVal('adjCos', adjGp - adjRev);
      const adjGpAdj = gpAdj * (1 + adjGpAdjPct);
      setVal('adjGpAdj', adjGpAdj);
      const adjOtherInc = otherInc * (1 + adjOtherIncPct);
      setVal('adjOtherInc', adjOtherInc);
      const adjTotalInc = adjGp + adjGpAdj + adjOtherInc;
      setVal('adjTotalInc', adjTotalInc);
      const adjOpExp = opExp * (1 + adjOpExpPct);
      setVal('adjOpExp', adjOpExp);
      const adjNop = adjTotalInc + adjOpExp;
      setVal('adjNop', adjNop);
      setVal('nopVar', adjNop - nop);

      // Adjusted trading account - ratios
      setVal('adjRevRatio', 1);
      setVal('adjCosRatio', adjRev !== 0 ? (adjGp - adjRev) / adjRev : 0);
      setVal('adjGpRatio', adjRev !== 0 ? adjGp / adjRev : 0);
      setVal('adjGpAdjRatio', adjRev !== 0 ? adjGpAdj / adjRev : 0);
      setVal('adjOtherIncRatio', adjRev !== 0 ? adjOtherInc / adjRev : 0);
      setVal('adjTotalIncRatio', adjRev !== 0 ? adjTotalInc / adjRev : 0);
      setVal('adjOpExpRatio', adjRev !== 0 ? adjOpExp / adjRev : 0);
      setVal('adjNopRatio', adjRev !== 0 ? adjNop / adjRev : 0);

      // Working capital days - calculated
      const monthlyCos = Math.abs(cos) / months;
      const monthlyRev = revenue / months;
      setVal('daysInv', monthlyCos !== 0 ? (inventory / monthlyCos) * 30 : 0);
      setVal('daysRec', monthlyRev !== 0 ? (receivables / monthlyRev) * 30 : 0);
      setVal('daysPay', (cos / months) !== 0 ? (payables / (cos / months)) * 30 : 0);

      // Adjusted balance sheet
      setVal('adjFixedAssets', fixedAssets);
      const targetDaysInv = getVal('targetDaysInv');
      const targetDaysRec = getVal('targetDaysRec');
      const targetDaysPay = getVal('targetDaysPay');
      
      const adjCos = adjGp - adjRev;
      const adjMonthlyCos = Math.abs(adjCos) / months;
      const adjMonthlyRev = adjRev / months;
      
      const adjInventory = targetDaysInv * adjMonthlyCos / 30;
      setVal('adjInventory', adjInventory);
      const adjReceivables = targetDaysRec * adjMonthlyRev / 30;
      setVal('adjReceivables', adjReceivables);
      const adjTotalAssets = fixedAssets + adjInventory + adjReceivables;
      setVal('adjTotalAssets', adjTotalAssets);
      const adjPayables = targetDaysPay * (adjCos / months) / 30;
      setVal('adjPayables', adjPayables);
      const adjNoa = adjTotalAssets + adjPayables;
      setVal('adjNoa', adjNoa);
      setVal('noaVar', adjNoa - noa);

      // Adjusted efficiency ratios
      const adjRos = adjRev !== 0 ? adjNop / adjRev : 0;
      setVal('adjRos', adjRos);
      const adjAt = adjNoa !== 0 ? adjRev / adjNoa : 0;
      setVal('adjAt', adjAt);
      setVal('adjRoa', adjRos * adjAt);
    
      }

