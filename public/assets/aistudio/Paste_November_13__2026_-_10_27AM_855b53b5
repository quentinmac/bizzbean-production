import { BizzPlanData, BizzModelData } from '../../../types';
import { Download, Info, MessageSquare, CheckCircle2, Printer, TrendingUp, Activity, PieChart, Calculator, FileText, Target } from 'lucide-react';
import jsPDF from 'jspdf';
import html2canvas from 'html2canvas';
import ScorecardReport, { ScorecardTable, ScorecardActions } from './ScorecardReport';
import AssumptionsReport from './AssumptionsReport';
